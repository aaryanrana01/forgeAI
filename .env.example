# Copy to .env and edit. Every value can also be set as an environment variable.

# --- local open model via Ollama (default) ---
FORGE_BACKEND=ollama
FORGE_MODEL=qwen2.5:7b-instruct
# A judge from a DIFFERENT model family reduces self-preference bias (needs ~16 GB RAM for both).
# Leave empty to use FORGE_MODEL.
FORGE_JUDGE_MODEL=
# Optional: enables hybrid (BM25 + dense) retrieval as an optimizer option.
FORGE_EMBED_MODEL=
# FORGE_BASE_URL=http://localhost:11434

# --- or any OpenAI-compatible server hosting an open model (Groq, OpenRouter, LM Studio, vLLM) ---
# FORGE_BACKEND=openai
# FORGE_BASE_URL=https://api.groq.com/openai/v1
# FORGE_API_KEY=...
# FORGE_MODEL=llama-3.1-8b-instant

# --- budget per factory run ---
FORGE_MAX_TOKENS=4000000
FORGE_MAX_SECONDS=14400
FORGE_MIN_GAIN=0.5
